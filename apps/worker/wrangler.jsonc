{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "hidden-spell-game",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-23",
  "workers_dev": true,
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "RoomDurableObject"
      }
    ]
  },
  "exports": {
    "RoomDurableObject": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
