{
  "name": "hidden-spell-game",
  "private": true,
  "packageManager": "npm@10.9.3",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspace @hidden-spell/web && npm run build --workspace @hidden-spell/worker"
  },
  "devDependencies": {
    "@playwright/cli": "^0.1.18",
    "typescript": "^5.9.2",
    "vitest": "^4.1.0"
  }
}
